{
  "name": "wikidot-editor-better-chrome-ext",
  "version": "2.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "将 Wikidot 编辑器的 textarea 替换为 Monaco Editor 的 Chrome 扩展",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && bun scripts/bundle.ts",
    "dev": "tsc --watch",
    "test": "bun test"
  },
  "devDependencies": {
    "bun": "^1.3.14",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "lucide": "^1.28.0"
  },
  "chrome": {
    "name": "Wikidot Editor Better (Monaco)",
    "match": ["*://*.wikidot.com/*", "*://wikidot.com/*"]
  }
}
